# Token que tú inventas; se pega igual en Meta > Webhooks > "Verify token"
META_VERIFY_TOKEN=
# Meta > App settings > Basic > App secret (valida que el webhook viene de Meta)
META_APP_SECRET=
GRAPH_API_VERSION=v23.0

# WhatsApp Cloud API (Meta > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Facebook Messenger e Instagram (token de la página de Facebook vinculada)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Neon (lo llena Vercel al conectar la base desde el Marketplace)
DATABASE_URL=

# ERP Prokarne (usuario con rol "Bot WhatsApp")
ERP_API_URL=
ERP_USER=
ERP_PASSWORD=
# Empleado (vendedor) a quien se asignan pedidos de clientes sin vendedor
ERP_VENDEDOR_ID=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
